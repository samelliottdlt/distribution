+
+static std::mutex sSelectionLock;
+static std::string sSelectionKey;
+static std::string sSelectionJson = "{\"seq\":0,\"view\":\"none\"}";
+static int sSelectionSeq = 0;
+
+void HttpApi::updateSelection()
+{
+	if (!ViewController::hasInstance())
+		return;
+
+	auto vc = ViewController::get();
+
+	std::string view = "none";
+	SystemData* system = nullptr;
+	FileData* cursor = nullptr;
+
+	if (vc->getViewMode() == ViewController::SYSTEM_SELECT)
+	{
+		view = "system";
+		system = vc->getSelectedSystem();
+	}
+	else if (vc->getViewMode() == ViewController::GAME_LIST)
+	{
+		view = "gamelist";
+		system = vc->getState().getSystem();
+
+		auto gameList = system != nullptr ? vc->getGameListView(system, false) : nullptr;
+		if (gameList != nullptr)
+			cursor = gameList->getCursor();
+	}
+
+	std::string key = view + "|" + (system != nullptr ? system->getName() : "") + "|" + (cursor != nullptr ? cursor->getPath() : "");
+
+	std::unique_lock<std::mutex> lock(sSelectionLock);
+	if (key == sSelectionKey)
+		return;
+
+	rapidjson::StringBuffer s;
+	rapidjson::PrettyWriter<rapidjson::StringBuffer> writer(s);
+
+	writer.StartObject();
+	writer.Key("seq"); writer.Int(++sSelectionSeq);
+	writer.Key("view"); writer.String(view.c_str());
+	writer.Key("system"); writer.String(system != nullptr ? system->getName().c_str() : "");
+	writer.Key("game");
+	if (cursor != nullptr && cursor->getType() == GAME)
+	{
+		writer.StartObject();
+		writer.Key("id"); writer.String(getFileDataId(cursor).c_str());
+		writer.Key("path"); writer.String(cursor->getPath().c_str());
+		writer.Key("name"); writer.String(cursor->getName().c_str());
+		writer.EndObject();
+	}
+	else
+		writer.Null();
+	writer.EndObject();
+
+	sSelectionKey = key;
+	sSelectionJson = s.GetString();
+}
+
+std::string HttpApi::getSelection()
+{
+	std::unique_lock<std::mutex> lock(sSelectionLock);
+	return sSelectionJson;
+}
